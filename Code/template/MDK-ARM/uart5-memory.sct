; Preserve flash/SRAM addresses; CPU-only tracking state uses the F407 CCM.
LR_IROM1 0x08000000 0x00100000 {
  ER_IROM1 0x08000000 0x00100000 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
    .ANY (+XO)
  }
  RW_CCM_TRACKING 0x10000000 0x00010000 {
    grabtask.o (CCM_TRACKING)
  }
  RW_IRAM1 0x20000000 0x0001C000 {
    .ANY (+RW +ZI)
  }
  RW_IRAM2 0x2001C000 0x00004000 {
    .ANY (+RW +ZI)
  }
}
